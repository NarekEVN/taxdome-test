# Copy to .env (cp .env.example .env). Read by docker compose and by the app/tests run on the host.

# Postgres container credentials.
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# App and tests running on the host: the db container is published on localhost:5433.
DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5433/payments
TEST_DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5433/payments_test

# App containers (app1, app2): they reach the db container by its service name on the compose network.
APP_DATABASE_URL=postgresql+psycopg://payments:payments@db:5432/payments
